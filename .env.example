# Postgres owner (runs migrations). Never exposed outside the compose network.
POSTGRES_USER=dueflow_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dueflow
POSTGRES_PORT=5432

# Restricted role the API connects as (created by migrations; no UPDATE/DELETE on events).
APP_DB_USER=dueflow_app
APP_DB_PASSWORD=change-me

# LLM provider keys. Model IDs live in config/models.yaml (committed), not here.
GROQ_API_KEY=
# Used when config/models.yaml sets provider: openai (agent: dev tests, Day 7, production).
OPENAI_API_KEY=

# Bearer token required on API routes (all except /health).
API_TOKEN=change-me
# Admin dashboard login (one shared password; login returns API_TOKEN). Empty = login off.
ADMIN_PASSWORD=
# Previous Groq key kept as a backup (not used automatically).
GROQ_API_KEY_BACKUP=
# Deepgram STT + TTS for voice (Day 5). Secret: .env only.
DEEPGRAM_API_KEY=
